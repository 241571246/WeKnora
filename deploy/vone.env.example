# Vone-weknora local deployment template.
#
# Deployment-time procedure:
#   1. Copy this file to the repository root as `.env`.
#   2. Fill every REQUIRED value locally.
#   3. Never commit or paste the resulting `.env` into tickets or chat.

# Deployment identity and locally built image tags
COMPOSE_PROJECT_NAME=vone-weknora
VONE_IMAGE_TAG=0.7.2-vone.1
# App can be released independently while DocReader/Sandbox keep VONE_IMAGE_TAG.
VONE_APP_IMAGE_TAG=0.7.2-vone.1
# UI customization is versioned separately so a visual-only release does not rebuild backend images.
VONE_UI_IMAGE_TAG=0.7.2-vone.2
TZ=Asia/Shanghai
GIN_MODE=release
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true
# First deployment must start in shadow. Switch to enforce only after reconciliation and authorization tests pass.
WEKNORA_VONE_KB_ACL_MODE=shadow

# Host ports. PostgreSQL, Redis and Docreader remain internal-only.
FRONTEND_PORT=80
APP_PORT=8080
APP_HOST=app
APP_BACKEND_PORT=8080
APP_SCHEME=http
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

# PostgreSQL / ParadeDB - REQUIRED
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=weknora
DB_PASSWORD=
DB_NAME=weknora
RETRIEVE_DRIVER=postgres

# Redis - REQUIRED
STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=stream:

# Application secrets - REQUIRED
# JWT_SECRET: random high-entropy value.
# SYSTEM_AES_KEY: exactly 32 bytes; back it up separately from the database.
JWT_SECRET=
SYSTEM_AES_KEY=

# Keep registration open only for the first administrator bootstrap.
DISABLE_REGISTRATION=false

# External Chat model - REQUIRED
VONE_LLM_MODEL_NAME=deepseek-v4-flash
VONE_LLM_BASE_URL=https://api.deepseek.com/v1
VONE_LLM_API_KEY=
VONE_LLM_PROVIDER=deepseek

# External Embedding model - REQUIRED
# Its vector dimension is a YAML integer in builtin_models.vone.yaml.
VONE_EMBEDDING_MODEL_NAME=BAAI/bge-m3
VONE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
VONE_EMBEDDING_API_KEY=
VONE_EMBEDDING_PROVIDER=siliconflow

# External Rerank model - REQUIRED for the selected Vone RAG profile
VONE_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
VONE_RERANK_BASE_URL=https://api.siliconflow.cn/v1
VONE_RERANK_API_KEY=
VONE_RERANK_PROVIDER=siliconflow

# Optional integrations disabled for the first deployment.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OIDC_AUTH_ENABLE=false

# WeKnora 独立钉钉登录应用（不要复用 PMS 应用凭据）。
WEKNORA_DINGTALK_AUTH_ENABLE=true
WEKNORA_DINGTALK_AUTH_CORP_ID=ding157a5b7f9716c2ba35c2f4657eb6378f
WEKNORA_DINGTALK_AUTH_CLIENT_ID=dingjopgqgscdji5lmkn
WEKNORA_DINGTALK_AUTH_CLIENT_SECRET=
WEKNORA_DINGTALK_AUTH_REDIRECT_URI=
WEKNORA_DINGTALK_AUTH_JIT_PROVISIONING=false
WEKNORA_DINGTALK_AUTH_EMAIL_AUTO_BIND=false
WEKNORA_DINGTALK_AUTH_AUTO_JOIN_TENANT=false
WEKNORA_DINGTALK_AUTH_DEFAULT_TENANT_ID=
WEKNORA_DINGTALK_AUTH_DEFAULT_TENANT_ROLE=viewer
WEKNORA_DINGTALK_AUTH_TIMEOUT=30s
WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=
PMS_URL=https://co.vonechina.com:11011

# Frontend build profile (used by npm/Vite before the Docker UI image is built).
# `vone` enables the VONE brand package; `upstream` keeps the original WeKnora login experience.
VITE_BRAND_PROFILE=vone
